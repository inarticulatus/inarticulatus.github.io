---
// Small coral label above a sentence-case heading. One shared style for every section.
interface Props {
  label: string;
  id?: string;
}
const { label, id } = Astro.props;
---

<div class="max-w-3xl">
  <p class="font-mono text-xs uppercase tracking-wider text-orange">{label}</p>
  <h2 id={id} class="mt-3 text-3xl md:text-4xl font-bold tracking-tight leading-tight text-black">
    <slot />
  </h2>
</div>
