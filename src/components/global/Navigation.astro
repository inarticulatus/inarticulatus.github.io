---
const path = Astro.url.pathname;
const links = [
  { href: "/projects/", label: "Work" },
  { href: "/about/", label: "About" },
  { href: "/learn/", label: "Learn" },
  { href: "/cv/Utkarsh-Tripathi-Resume.pdf", label: "Resume" },
];
---

<header class="border-b border-black/10 bg-white">
  <nav aria-label="Site"
    class="mx-auto max-w-6xl px-6 md:px-10 py-5 flex flex-wrap items-center justify-between gap-x-8 gap-y-3">
    <a href="/" class="font-bold tracking-tight text-lg text-black hover:text-orange">Utkarsh Tripathi</a>
    <div class="flex flex-wrap items-center gap-x-6 gap-y-2 text-[15px]">
      {links.map((l) => (
        <a href={l.href}
          aria-current={path.startsWith(l.href) ? "page" : undefined}
          class:list={[
            "hover:text-orange",
            path.startsWith(l.href)
              ? "font-semibold text-black underline decoration-orange decoration-2 underline-offset-8"
              : "text-black/70",
          ]}>
          {l.label}
        </a>
      ))}
      <a href="mailto:utkarsh1999tripathi@gmail.com"
        class="bg-black text-white font-semibold px-4 py-2 hover:bg-orange">
        Email me
      </a>
    </div>
  </nav>
</header>
