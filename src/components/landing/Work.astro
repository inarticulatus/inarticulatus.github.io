---
import SectionTitle from "../assets/SectionTitle.astro";
import { getCollection } from "astro:content";

const posts = await getCollection('projects', ({ data }) => {
const categories = Array.isArray(data.category)
? data.category.map(c => c.toLowerCase())
: [data.category.toLowerCase()];
return categories.includes('project') || categories.includes('projects');
});
// Lead with the BFSI case studies, then the strongest engineering write-ups.
const FEATURED = ['cited-extraction-pipeline', 'llm-claim-grounding'];
const featuredEntries = FEATURED.map(id => posts.find(p => p.id === id)).filter(Boolean);
const rest = posts.filter(p => !FEATURED.includes(p.id));
const limitedEntries = [...featuredEntries, ...rest].slice(0, 3);
---

<section class="border-b border-black/20 divide-y divide-black/20">
  <SectionTitle>
    Projects
  </SectionTitle>
  <div class="p-8">
    <p class="text-black/80 font-black uppercase lg:text-xl">
      Data engineering and applied ML for banks, insurers and fintechs. <em>Evaluation
      and assurance on top, so the output holds up to a reviewer.</em>
    </p>
  </div>

  <!-- Project cards in horizontal row -->
  <div class="grid grid-cols-1 md:grid-cols-2">
    {limitedEntries.map((post) => {
    const categories = Array.isArray(post.data.category) ? post.data.category : [post.data.category];
    const displayCategory = categories.find(c => !['project', 'projects', 'research'].includes(c.toLowerCase())) ||
    categories[0];
    return (
    <a href={`/projects/${post.id}/`}
      class="p-8 border-b border-black/10 md:border-b md:odd:border-r hover:bg-orange/5 transition-colors block">
      <!-- Category label -->
      <p class="text-cyan text-sm font-mono mb-3 underline underline-offset-4 uppercase">
        {displayCategory}
      </p>

      <!-- Title -->
      <h4 class="font-black text-black uppercase text-sm lg:text-base mb-4 leading-tight">
        {post.data.title}
      </h4>

      <!-- Description -->
      <p class="text-black/70 text-sm leading-relaxed">
        {post.data.description}
      </p>
    </a>
    )})}
  </div>

  <div class="p-8 border-t border-black/10">
    <a href="/about/" class="text-cyan text-sm font-mono uppercase underline underline-offset-4">
      Working with me &rarr;
    </a>
    <p class="text-black/70 text-sm mt-2">
      Single-system evaluation, an evaluation harness build, or a monthly assurance
      pass. Advisory, documentation and technical testing &mdash; not a legal opinion,
      and not a conformity assessment, certification or attestation under any
      regulatory regime.
    </p>
  </div>
</section>