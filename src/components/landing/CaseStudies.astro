---
import { getCollection } from "astro:content";
import SectionHead from "../assets/SectionHead.astro";

// The write-ups closest to client work, in the order a buyer should read them.
const FEATURED: Record<string, string> = {
  "cited-extraction-pipeline": "Regulated documents",
  "llm-claim-grounding": "LLM evaluation",
  "craton-labs": "Compliance search",
  "konkan-railway-store-and-forward": "Field data",
};
const posts = await getCollection("projects");
const featured = Object.keys(FEATURED)
  .map((id) => posts.find((p) => p.id === id))
  .filter((p) => p !== undefined);
---

<section id="work" class="border-b border-black/10">
  <div class="mx-auto max-w-6xl px-6 md:px-10 py-20">
    <SectionHead label="Case studies">What the work looks like.</SectionHead>

    <ul class="mt-12 border-t border-black/15">
      {featured.map((post) => (
        <li class="border-b border-black/15">
          <a href={`/projects/${post.id}/`}
            class="group grid gap-2 py-7 md:grid-cols-[180px_1fr_auto] md:gap-8 md:items-baseline hover:bg-orange/5 md:px-3 md:-mx-3">
            <span class="font-mono text-xs uppercase tracking-wider text-cyan">{FEATURED[post.id]}</span>
            <span>
              <span class="block text-xl font-bold tracking-tight text-black group-hover:text-orange">{post.data.title}</span>
              <span class="mt-2 block text-black/70 leading-relaxed max-w-2xl">{post.data.description}</span>
            </span>
            <span aria-hidden="true" class="hidden md:block text-black/40 group-hover:text-orange">&rarr;</span>
          </a>
        </li>
      ))}
    </ul>

    <a href="/projects/" class="mt-8 inline-block font-semibold underline decoration-black/30 underline-offset-4 hover:decoration-orange">
      All work and writing &rarr;
    </a>
  </div>
</section>
