---
import SectionHead from "../assets/SectionHead.astro";

// The four areas the site is built around. "status" keeps the claims honest:
// shipped work vs. what I'm building now.
const areas = [
  {
    n: "01",
    title: "RLHF and post-training",
    status: "Current focus",
    body: "Reward models, preference optimisation with PPO, GRPO and DPO, and verifiable rewards that hold up against reward hacking.",
    links: [
      { href: "/learn/frontier-ai/", label: "Frontier AI study tracker" },
      { href: "/projects/tradr/", label: "Tradr, with its RL trading agent" },
    ],
  },
  {
    n: "02",
    title: "AI sandboxing",
    status: "Current focus",
    body: "Isolated environments where coding agents and RL policies can run untrusted code, scored by verifiers they can't escape or game.",
    links: [{ href: "/learn/rl-environments/", label: "RL environment engineering workbook" }],
  },
  {
    n: "03",
    title: "Applied ML and deep learning",
    status: "Shipped",
    body: "Models that run in production: YOLOv7 licence-plate recognition on edge devices, two-tower retrieval with DeepFM ranking, and time-series forecasting.",
    links: [
      { href: "/projects/recommender-system/", label: "Real-time recommender" },
      { href: "/projects/ml-from-scratch/", label: "ML algorithms in plain NumPy" },
    ],
  },
  {
    n: "04",
    title: "AI optimisation",
    status: "Shipped",
    body: "Making models fit the hardware: real-time detection at 15+ FPS on a low-power ARM board, and now GPU kernels, memory maths and efficient serving for large models.",
    links: [{ href: "/learn/frontier-ai/", label: "Frontier AI study tracker" }],
  },
];
---

<section id="focus" class="border-b border-black/10 scroll-mt-4">
  <div class="mx-auto max-w-6xl px-6 md:px-10 py-20">
    <SectionHead label="Focus">What I work on.</SectionHead>

    <ol class="mt-12 grid gap-px bg-black/10 border border-black/10 md:grid-cols-2">
      {areas.map((a) => (
        <li class="bg-white p-7 md:p-9 flex flex-col">
          <div class="flex items-center justify-between gap-4">
            <span class="font-mono text-sm text-black/40">{a.n}</span>
            <span class:list={[
              "font-mono text-xs uppercase tracking-wider px-2 py-0.5",
              a.status === "Shipped" ? "bg-cyan/15 text-cyan" : "bg-orange/15 text-orange",
            ]}>{a.status}</span>
          </div>
          <h3 class="mt-6 text-2xl md:text-3xl font-bold tracking-tight text-black">{a.title}</h3>
          <p class="mt-3 text-black/70 leading-relaxed">{a.body}</p>
          <ul class="mt-auto pt-6 space-y-1.5 text-sm">
            {a.links.map((l) => (
              <li>
                <a href={l.href} class="font-semibold text-black underline decoration-black/25 underline-offset-4 hover:decoration-orange">
                  {l.label} &rarr;
                </a>
              </li>
            ))}
          </ul>
        </li>
      ))}
    </ol>
  </div>
</section>
