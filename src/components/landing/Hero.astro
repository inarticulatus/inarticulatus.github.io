---
import BgGrid from "../assets/BgGrid.astro";

// Results from shipped work (see the resume). Keep these in step with it.
const stats = [
  { value: "15+ FPS", label: "YOLOv7 inference on a low-power ARM board" },
  { value: "50%", label: "lower cost than the commercial ANPR systems it replaced" },
  { value: "+15%", label: "sales forecast precision from Prophet models" },
  { value: "40%", label: "lower reporting latency from PySpark pipelines" },
];

// What's on the desk right now. Update as it changes.
const now = [
  { kind: "Building", what: "Craton Labs", detail: "AI systems for banks, insurers and fintechs" },
  { kind: "Studying", what: "RLHF and post-training", detail: "PPO, GRPO, DPO and reward hacking", href: "/learn/frontier-ai/" },
  { kind: "Studying", what: "Sandboxed RL environments", detail: "Isolation and verifiers agents can't game", href: "/learn/rl-environments/" },
  { kind: "Studying", what: "Inference optimisation", detail: "GPU kernels, memory maths, efficient serving", href: "/learn/frontier-ai/" },
  { kind: "Shipped", what: "Edge licence-plate recognition", detail: "YOLOv7 on a BeagleY-AI board at 15+ FPS" },
];
---

<section class="relative border-b border-black/10">
  <BgGrid />
  <div class="relative mx-auto max-w-6xl px-6 md:px-10 pt-14 md:pt-20 pb-14">
    <p class="font-mono text-xs uppercase tracking-wider text-orange">
      AI engineer &middot; Founder and CTO, Craton Labs
    </p>
    <h1 class="mt-5 text-5xl sm:text-6xl md:text-7xl lg:text-8xl font-bold tracking-tighter leading-[0.95] text-black">
      Utkarsh Tripathi<span class="text-orange">.</span>
    </h1>

    <div class="mt-10 grid gap-12 lg:grid-cols-[1.15fr_1fr] lg:items-start">
      <div>
        <p class="max-w-xl text-2xl md:text-3xl font-semibold tracking-tight leading-snug text-black">
          I build ML systems that learn from feedback, run safely and run fast.
        </p>
        <p class="mt-5 max-w-xl text-lg leading-relaxed text-black/70">
          Applied ML and deep learning in production, from real-time computer vision on edge
          hardware to recommenders and forecasting. Now going deep on RLHF and post-training,
          sandboxed environments for AI agents, and inference optimisation.
        </p>
        <div class="mt-9 flex flex-wrap items-center gap-3">
          <a href="#focus" class="bg-orange text-white font-semibold px-5 py-3 hover:bg-black">
            What I work on &darr;
          </a>
          <a href="#work" class="border border-black/80 bg-white font-semibold px-5 py-3 hover:bg-black hover:text-white">
            Selected work
          </a>
          <a href="/cv/Utkarsh-Tripathi-Resume.pdf"
            class="px-3 py-3 font-semibold underline decoration-black/30 underline-offset-4 hover:decoration-orange">
            Resume (PDF)
          </a>
        </div>
      </div>

      <aside aria-label="What I'm working on now"
        class="bg-[#fdfcfa] border border-black/80 shadow-[8px_8px_0_0_rgba(45,45,45,0.85)]">
        <div class="flex items-center justify-between gap-4 border-b border-black/15 px-5 py-3 font-mono text-xs uppercase tracking-wider text-black/55">
          <span class="flex items-center gap-2">
            <span class="relative flex h-2 w-2" aria-hidden="true">
              <span class="absolute inline-flex h-full w-full rounded-full bg-cyan opacity-60 motion-safe:animate-ping"></span>
              <span class="relative inline-flex h-2 w-2 rounded-full bg-cyan"></span>
            </span>
            Now
          </span>
          <span>What's on my desk</span>
        </div>
        <ul class="divide-y divide-black/10">
          {now.map((n) => {
            const Row = n.href ? "a" : "div";
            return (
              <li>
                <Row href={n.href}
                  class:list={["group grid grid-cols-[76px_1fr_auto] gap-3 px-5 py-3.5", n.href && "hover:bg-orange/5"]}>
                  <span class:list={[
                    "font-mono text-[11px] uppercase tracking-wider pt-0.5",
                    n.kind === "Shipped" ? "text-cyan" : n.kind === "Building" ? "text-black/55" : "text-orange",
                  ]}>{n.kind}</span>
                  <span class="min-w-0">
                    <span class="block font-semibold text-black">{n.what}</span>
                    <span class="block text-sm text-black/60">{n.detail}</span>
                  </span>
                  <span aria-hidden="true" class="text-black/30 group-hover:text-orange">{n.href ? "→" : ""}</span>
                </Row>
              </li>
            );
          })}
        </ul>
      </aside>
    </div>
  </div>

  <dl class="relative mx-auto max-w-6xl px-6 md:px-10 pb-16 md:pb-20">
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-px bg-black/10 border border-black/10">
      {stats.map((s) => (
        <div class="bg-white p-5 md:p-6">
          <dt class="sr-only">{s.label}</dt>
          <dd class="text-3xl md:text-4xl font-bold tracking-tight text-black">{s.value}</dd>
          <dd class="mt-2 text-sm leading-snug text-black/60">{s.label}</dd>
        </div>
      ))}
    </div>
  </dl>
</section>
