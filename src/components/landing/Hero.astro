---
// Assets
import BgGrid from "../assets/BgGrid.astro";
---

<section class="border-black/20 border-b">
  <div class="p-8 relative">
    <BgGrid />
    <h1
      class="text-black/70 tracking-tighter font-black uppercase text-3xl md:text-5xl lg:text-8xl relative leading-[1.2]">
      <span class="bg-orange px-4 text-white">Utkarsh Tripathi</span>
      <br>
      I make AI show its work
    </h1>
  </div>
  <div class="px-8 pb-8 space-y-6">
    <p class="text-black/60 font-bold lg:text-xl">
      Founder &amp; CTO, Craton Labs &middot; verifiable AI for banks, insurers and fintechs
    </p>
    <p class="font-black uppercase text-xl md:text-3xl lg:text-5xl tracking-tight leading-tight">
      <span class="block text-sm lg:text-base font-mono font-medium text-black/50 tracking-normal mb-1">Now going deep on</span>
      <span class="typewriter text-orange" data-words='["AI sandboxing","RLHF","AI optimization"]'>AI sandboxing</span>
    </p>
    <div class="flex flex-wrap gap-3">
      <a href="#focus"
        class="uppercase font-black text-sm px-4 py-2 bg-orange text-white border-2 border-orange hover:bg-white hover:text-orange">
        Current focus &darr;
      </a>
      <a href="/projects/"
        class="uppercase font-black text-sm px-4 py-2 border-2 border-black/80 text-black hover:bg-black hover:text-white">
        Case studies &rarr;
      </a>
    </div>
  </div>
</section>

<script>
  // Types each word, holds, erases, then moves on. The server-rendered word is the
  // fallback for no-JS and reduced-motion users, so nothing is empty or shifts.
  const el = document.querySelector<HTMLElement>(".typewriter");
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (el && !reduce) {
    const words: string[] = JSON.parse(el.dataset.words ?? "[]");
    const TYPE_MS = 90;
    const ERASE_MS = 45;
    const HOLD_MS = 2200;
    const GAP_MS = 350;
    let w = 0;
    let i = el.textContent!.length;

    const wait = (ms: number) => new Promise((r) => setTimeout(r, ms));

    const run = async () => {
      if (words.length < 2) return;
      await wait(HOLD_MS);
      for (;;) {
        el.classList.add("typing");
        while (i > 0) {
          el.textContent = words[w].slice(0, --i);
          await wait(ERASE_MS);
        }
        await wait(GAP_MS);
        w = (w + 1) % words.length;
        while (i < words[w].length) {
          el.textContent = words[w].slice(0, ++i);
          await wait(TYPE_MS);
        }
        el.classList.remove("typing");
        await wait(HOLD_MS);
      }
    };

    run();
  }
</script>
