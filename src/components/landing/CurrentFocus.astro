---
import SectionTitle from "../assets/SectionTitle.astro";

// Mirrors the two study trackers under /learn/. Keep these in step with them.
const focus = [
  {
    label: "AI sandboxing",
    title: "Safe execution for coding agents",
    body: "Air-gapped containers, anti-tamper verifiers, seccomp and cgroup limits, and pass-to-pass / fail-to-pass tests that catch reward hacking.",
    href: "/learn/rl-environments/",
    cta: "RL environment workbook",
  },
  {
    label: "RLHF & post-training",
    title: "Reward signals you can trust",
    body: "PPO, GRPO and DPO from first principles, verifiable rewards, and diagnosing KL spikes and reward hacking.",
    href: "/learn/frontier-ai/",
    cta: "Frontier AI study tracker",
  },
  {
    label: "AI optimization",
    title: "Faster, cheaper inference and training",
    body: "GPU kernels in Triton and CUDA, roofline analysis, KV-cache and ZeRO memory math, and serving large models efficiently.",
    href: "/learn/frontier-ai/",
    cta: "Frontier AI study tracker",
  },
];
---

<section id="focus" class="border-black/20 border-b divide-y divide-black/20">
  <SectionTitle>
    Current Focus
  </SectionTitle>
  <div class="p-8">
    <p class="text-black/80 font-black uppercase lg:text-xl">
      Going deeper on the systems underneath trustworthy AI: how agents are contained, trained and made fast.
    </p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3">
    {focus.map((item) => (
      <a
        href={item.href}
        class="p-8 border-b border-black/10 md:border-b-0 md:[&:not(:last-child)]:border-r hover:bg-orange/5 transition-colors block"
      >
        <p class="text-cyan text-sm font-mono mb-3 underline underline-offset-4 uppercase">{item.label}</p>
        <h4 class="font-black text-black uppercase text-sm lg:text-base mb-4 leading-tight">{item.title}</h4>
        <p class="text-black/70 text-sm leading-relaxed">{item.body}</p>
        <p class="mt-4 text-orange text-xs font-mono uppercase">{item.cta} &rarr;</p>
      </a>
    ))}
  </div>

  <div class="p-8">
    <a href="/learn/" class="text-cyan text-sm font-mono uppercase underline underline-offset-4">
      See how I'm studying it &rarr;
    </a>
    <p class="text-black/70 text-sm mt-2">
      Two open study trackers with a day-by-day plan, reference sheets and self-checks.
    </p>
  </div>
</section>
