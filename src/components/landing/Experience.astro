---
import SectionHead from "../assets/SectionHead.astro";

const roles = [
  { dates: "Oct 2025 – now", title: "Founder and CTO", company: "Craton Labs", what: "LLM evaluation and assurance for financial services" },
  { dates: "Jan – Sep 2025", title: "Data Engineer", company: "RiskPe", what: "PySpark pipelines, SQL and Power BI reporting" },
  { dates: "Jul – Dec 2024", title: "Computer Vision Engineer", company: "Habitat", what: "Models on edge hardware, with CI/CD" },
  { dates: "2021 – 2023", title: "Systems Engineer", company: "Siemens", what: "ETL and data pipelines in Python" },
];
---

<section id="background" class="border-b border-black/10">
  <div class="mx-auto max-w-6xl px-6 md:px-10 py-20 grid gap-12 lg:grid-cols-[1fr_1.2fr]">
    <div>
      <SectionHead label="Background">Who you'd be working with.</SectionHead>
      <p class="mt-5 text-lg text-black/70 leading-relaxed">
        I came to LLM evaluation from data engineering, so I test the documents, retrieval
        and pipeline behind an answer as well as the answer itself.
      </p>
      <a href="/about/" class="mt-6 inline-block font-semibold underline decoration-black/30 underline-offset-4 hover:decoration-orange">
        More about me &rarr;
      </a>
    </div>

    <ol class="border-t border-black/15 self-start">
      {roles.map((r) => (
        <li class="grid gap-1 border-b border-black/15 py-5 sm:grid-cols-[140px_1fr] sm:gap-6">
          <span class="font-mono text-sm text-black/50">{r.dates}</span>
          <span>
            <span class="font-bold text-black">{r.title}</span>
            <span class="text-black/50">, </span>
            <span class="font-semibold text-orange">{r.company}</span>
            <span class="mt-1 block text-black/65">{r.what}</span>
          </span>
        </li>
      ))}
    </ol>
  </div>
</section>
