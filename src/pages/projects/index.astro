---
import { getCollection } from "astro:content";
import FormattedDate from "../../components/FormattedDate.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";

// Grouped by area, applied ML first.
const GROUPS = [
  {
    label: "Applied ML and deep learning",
    intro: "Models trained, evaluated and served.",
    ids: ["recommender-system", "tradr", "ml-from-scratch", "customer-segmentation", "dimensionality-reduction", "ab-testing-framework"],
  },
  {
    label: "LLM systems",
    intro: "Retrieval, evaluation and AI products.",
    ids: ["studygrove", "rag-pipeline", "llm-claim-grounding", "cited-extraction-pipeline", "craton-labs"],
  },
  {
    label: "Systems and tools",
    intro: "Edge hardware, offline apps and build tooling.",
    ids: ["konkan-railway-store-and-forward", "audiobook-app", "pyresume"],
  },
];

const posts = await getCollection("projects");
const grouped = new Set(GROUPS.flatMap((g) => g.ids));
const groups = GROUPS.map((g) => ({
  ...g,
  items: g.ids.map((id) => posts.find((p) => p.id === id)).filter((p) => p !== undefined),
}));
const others = posts.filter((p) => !grouped.has(p.id));
if (others.length) groups.push({ label: "More", intro: "", ids: [], items: others });
---

<BaseLayout title="Projects" description="Projects in applied machine learning and deep learning, LLM systems, and edge and systems engineering.">
  <section class="border-b border-black/10">
    <div class="mx-auto max-w-6xl px-6 md:px-10 py-16 md:py-20">
      <p class="font-mono text-xs uppercase tracking-wider text-orange">Work</p>
      <h1 class="mt-5 max-w-3xl text-4xl md:text-6xl font-bold tracking-tight leading-[1.05]">
        Projects
      </h1>
      <p class="mt-6 max-w-2xl text-lg text-black/70 leading-relaxed">
        Write-ups of what I've built, with the design decisions and what I learned.
      </p>
    </div>
  </section>

  {groups.map((g) => (
    <section class="border-b border-black/10">
      <div class="mx-auto max-w-6xl px-6 md:px-10 py-14 grid gap-8 lg:grid-cols-[240px_1fr]">
        <div>
          <h2 class="text-xl font-bold tracking-tight">{g.label}</h2>
          {g.intro && <p class="mt-2 text-sm text-black/60 leading-relaxed">{g.intro}</p>}
        </div>
        <ul class="border-t border-black/15">
          {g.items.map((post) => (
            <li class="border-b border-black/15">
              <a href={`/projects/${post.id}/`} class="group block py-6">
                <span class="block text-lg md:text-xl font-bold tracking-tight group-hover:text-orange">{post.data.title}</span>
                <span class="mt-2 block text-black/70 leading-relaxed max-w-2xl">{post.data.description}</span>
                <span class="mt-2 block font-mono text-xs text-black/45"><FormattedDate date={post.data.pubDate} /></span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  ))}
</BaseLayout>
