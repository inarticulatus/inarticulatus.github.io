---
import { getCollection } from "astro:content";
import FormattedDate from "../../components/FormattedDate.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";

// Grouped for a client reading top to bottom: client-style work first, coursework last.
const CASE_STUDIES = [
  "cited-extraction-pipeline",
  "llm-claim-grounding",
  "craton-labs",
  "konkan-railway-store-and-forward",
];
const COURSEWORK = [
  "ab-testing-framework",
  "dimensionality-reduction",
  "ml-from-scratch",
  "customer-segmentation",
];

const posts = await getCollection("projects");
const byDate = (a: (typeof posts)[number], b: (typeof posts)[number]) =>
  b.data.pubDate.valueOf() - a.data.pubDate.valueOf();
const pick = (ids: string[]) =>
  ids.map((id) => posts.find((p) => p.id === id)).filter((p) => p !== undefined);

const groups = [
  { label: "Case studies", intro: "The write-ups closest to what I do for clients.", items: pick(CASE_STUDIES) },
  {
    label: "Side projects",
    intro: "Things I built for myself or to learn a tool properly.",
    items: posts.filter((p) => !CASE_STUDIES.includes(p.id) && !COURSEWORK.includes(p.id)).sort(byDate),
  },
  { label: "Coursework, 2024", intro: "Statistics and ML exercises from before Craton Labs.", items: pick(COURSEWORK) },
];
---

<BaseLayout title="Work" description="Case studies in LLM evaluation and document pipelines for regulated finance, plus side projects and coursework.">
  <section class="border-b border-black/10">
    <div class="mx-auto max-w-6xl px-6 md:px-10 py-16 md:py-20">
      <p class="font-mono text-xs uppercase tracking-wider text-orange">Work</p>
      <h1 class="mt-5 max-w-3xl text-4xl md:text-6xl font-bold tracking-tight leading-[1.05]">
        Work and writing
      </h1>
      <p class="mt-6 max-w-2xl text-lg text-black/70 leading-relaxed">
        Systems I've built and tested, written up in enough detail to judge the approach.
      </p>
    </div>
  </section>

  {groups.map((g) => (
    <section class="border-b border-black/10">
      <div class="mx-auto max-w-6xl px-6 md:px-10 py-14 grid gap-8 lg:grid-cols-[240px_1fr]">
        <div>
          <h2 class="text-xl font-bold tracking-tight">{g.label}</h2>
          <p class="mt-2 text-sm text-black/60 leading-relaxed">{g.intro}</p>
        </div>
        <ul class="border-t border-black/15">
          {g.items.map((post) => (
            <li class="border-b border-black/15">
              <a href={`/projects/${post.id}/`} class="group block py-6">
                <span class="block text-lg md:text-xl font-bold tracking-tight group-hover:text-orange">{post.data.title}</span>
                <span class="mt-2 block text-black/70 leading-relaxed max-w-2xl">{post.data.description}</span>
                <span class="mt-2 block font-mono text-xs text-black/45"><FormattedDate date={post.data.pubDate} /></span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  ))}
</BaseLayout>
