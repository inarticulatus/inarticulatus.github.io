---
import BaseLayout from '../layouts/BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';

interface Props {
title: string;
description: string;
pubDate: Date;
heroImage?: string;
category?: string | string[];
}

const { title, description, pubDate, heroImage, category } = Astro.props;
const categories = Array.isArray(category) ? category : [category].filter(Boolean);
---

<BaseLayout title={title} description={description}>
  <article class="mx-auto max-w-3xl px-6 md:px-10 py-14 md:py-20">
    <header class="mb-12">
      <a href="/projects/" class="font-mono text-xs uppercase tracking-wider text-orange hover:underline underline-offset-4">&larr; Work</a>
      <h1 class="mt-6 text-4xl md:text-5xl font-bold tracking-tight leading-[1.08] text-black">
        {title}
      </h1>
      <p class="mt-5 text-xl text-black/70 leading-relaxed">
        {description}
      </p>
      <p class="mt-5 flex flex-wrap items-center gap-x-4 gap-y-2 font-mono text-xs text-black/50">
        <FormattedDate date={pubDate} />
        {categories.filter((c) => !["projects", "project", "research"].includes(String(c).toLowerCase())).map((cat) => (
          <span class="uppercase tracking-wider">{cat}</span>
        ))}
      </p>
    </header>

    <div class="blog-content">
      <slot />
    </div>

    <aside class="mt-16 border border-black/80 bg-[#fdfcfa] p-6 md:p-8">
      <p class="text-lg font-bold tracking-tight">Working on RL, model training or inference?</p>
      <p class="mt-2 text-black/70">I take on independent consulting work. Email <a href="mailto:utkarsh1999tripathi@gmail.com" class="font-semibold text-black underline decoration-orange underline-offset-4">utkarsh1999tripathi@gmail.com</a>.</p>
    </aside>

    <div class="mt-12 pt-8 border-t border-black/10">
      <a href="/projects/" class="font-semibold underline decoration-black/30 underline-offset-4 hover:decoration-orange">&larr; All work and writing</a>
    </div>
  </article>
</BaseLayout>

<style is:global>
  .blog-content {
    color: #2d2d2d;
    font-size: 1.125rem;
    line-height: 1.8;
  }

  /* Headings */
  .blog-content h2 {
    font-size: 1.75rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.2;
    color: #2d2d2d;
    margin-top: 3.5rem;
    margin-bottom: 1.25rem;
  }

  .blog-content h3 {
    font-size: 1.3rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: #2d2d2d;
    margin-top: 2rem;
    margin-bottom: 1rem;
  }

  .blog-content h4 {
    font-size: 1.25rem;
    font-weight: 600;
    color: #2d2d2d;
    margin-top: 1.5rem;
    margin-bottom: 0.75rem;
  }

  /* Paragraphs */
  .blog-content p {
    margin-bottom: 1.5rem;
    color: #2d2d2d;
  }

  /* Links */
  .blog-content a {
    color: #2d2d2d;
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: rgba(45, 45, 45, 0.3);
    text-underline-offset: 4px;
  }

  .blog-content a:hover {
    text-decoration-color: #e85a4f;
  }

  /* Strong and emphasis */
  .blog-content strong {
    color: #2d2d2d;
    font-weight: 600;
  }

  .blog-content em {
    font-style: italic;
  }

  /* Lists */
  .blog-content ul {
    list-style-type: disc;
    padding-left: 1.5rem;
    margin-bottom: 1.5rem;
  }

  .blog-content ol {
    list-style-type: decimal;
    padding-left: 1.5rem;
    margin-bottom: 1.5rem;
  }

  .blog-content li {
    margin-bottom: 0.5rem;
    color: #2d2d2d;
  }

  .blog-content li::marker {
    color: #e85a4f;
  }

  /* Inline code */
  .blog-content code:not(pre code) {
    background: rgba(42, 157, 143, 0.15);
    color: #2a9d8f;
    padding: 0.2rem 0.5rem;
    border-radius: 0;
    font-size: 0.9em;
    font-family: 'Geist Mono', monospace;
  }

  /* Code blocks */
  .blog-content pre {
    background: #2d2d2d;
    border: 1px solid rgba(232, 90, 79, 0.3);
    border-radius: 0;
    padding: 1.25rem;
    overflow-x: auto;
    margin-bottom: 1.5rem;
    font-size: 0.9rem;
  }

  .blog-content pre code {
    background: none;
    color: #faf8f5;
    padding: 0;
    font-family: 'Geist Mono', monospace;
  }

  /* Blockquotes */
  .blog-content blockquote {
    border-left: 3px solid #e85a4f;
    background: rgba(232, 90, 79, 0.06);
    padding: 1rem 1.25rem;
    margin: 1.5rem 0;
    border-radius: 0;
    color: #2d2d2d;
  }

  /* Tables */
  .blog-content table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 1.5rem;
    font-size: 0.95rem;
  }

  .blog-content th {
    background: rgba(232, 90, 79, 0.1);
    border: 1px solid rgba(232, 90, 79, 0.3);
    padding: 0.75rem 1rem;
    text-align: left;
    font-weight: 600;
    color: #e85a4f;
  }

  .blog-content td {
    border: 1px solid rgba(45, 45, 45, 0.15);
    padding: 0.75rem 1rem;
    color: #2d2d2d;
  }

  .blog-content tr:nth-child(even) td {
    background: rgba(42, 157, 143, 0.05);
  }

  /* Horizontal rule */
  .blog-content hr {
    border: none;
    border-top: 2px solid #e85a4f;
    margin: 2.5rem 0;
  }

  /* Images */
  .blog-content img {
    max-width: 100%;
    border-radius: 0;
    margin: 1.5rem 0;
    border: 1px solid rgba(232, 90, 79, 0.2);
  }

  /* KaTeX math styling */
  .blog-content .katex {
    color: #2d2d2d;
  }

  .blog-content .katex-display {
    margin: 1.5rem 0;
    padding: 1rem;
    background: rgba(233, 196, 106, 0.1);
    border-radius: 0;
    overflow-x: auto;
  }
</style>